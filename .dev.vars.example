# Variables de configuración del SERVIDOR para desarrollo local (wrangler pages dev)
# Copia este archivo a .dev.vars y rellena los valores reales.
# NUNCA subas .dev.vars a Git (está en .gitignore).

# Google Identity Services (OAuth)
GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"

# Turso Database (libSQL para Fidelización de Clientes)
TURSO_URL="libsql://tu-db.turso.io"
TURSO_AUTH_TOKEN="tu-turso-auth-token"

# Administradores iniciales (formato: email:nombre,email:nombre)
ADMIN_SEEDS="admin@tudominio.com:Administrador Principal"