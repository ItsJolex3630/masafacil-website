# ============================================================
# Variables de configuración PÚBLICA para Masa Fácil
# ------------------------------------------------------------
# Solo valores que pueden verse en el navegador. NUNCA pongas
# aquí tokens de base de datos ni secretos de servidor.
#
# Los secretos reales (TURSO_AUTH_TOKEN, GOOGLE_CLIENT_ID del
# servidor, ADMIN_SEEDS) viven ÚNICAMENTE en Cloudflare:
#   Dashboard > Workers & Pages > masafacil-website >
#   Settings > Variables and Secrets
# y se leen en el backend vía `env.NOMBRE` (functions/*.js).
# ============================================================

VITE_PUBLIC_WHATSAPP_NUMBER=584244099610
VITE_PUBLIC_BUSINESS_NAME="Masafácil · El Maracucho"
VITE_PUBLIC_INSTAGRAM="masafacil_ve"

# Google Identity Services (OAuth). El client_id es un identificador
# PÚBLICO por diseño (no es un secreto), pero debe coincidir con el
# GOOGLE_CLIENT_ID configurado en Cloudflare para validar la audiencia.
VITE_PUBLIC_GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"

# ============================================================
# ⚠️  La base de datos (Turso/libSQL) NO se conecta desde el
# cliente. Toda lectura/escritura pasa por /api/* (Pages
# Functions), que conserva el token en el servidor.
# ============================================================